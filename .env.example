# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio, or http://localhost:3000 locally.
APP_URL="http://localhost:3000"

# SESSION_SECRET: 32+ byte random secret used for session signature verification
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-secret"

# DOCUMENT_MASTER_KEY: 256-bit (32 byte) Base64 master key for server-side envelope encryption
DOCUMENT_MASTER_KEY="replace-with-base64-encoded-32-byte-master-key"

# OTP_HMAC_SECRET: Secret key used to HMAC-hash recipient email verification OTP codes
OTP_HMAC_SECRET="replace-with-secure-otp-hmac-secret-string"

# EMAIL_FROM: Verified sender address for transactional security emails
EMAIL_FROM="HavenVault Security <onboarding@resend.dev>"

# RESEND_API_KEY: Resend API Key for real email delivery (re_...)
# Set via the Secrets / Environment panel in AI Studio.
RESEND_API_KEY=""

# SENDGRID_API_KEY: Optional alternative email provider (SG....)
SENDGRID_API_KEY=""

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY=""
